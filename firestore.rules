rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validScore() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        // 1120 levels, 3 stars each.
        && request.resource.data.stars <= 3360
        && request.resource.data.levels is int
        && request.resource.data.levels >= 0
        && request.resource.data.levels <= 1120
        && request.resource.data.updatedAt == request.time;
    }

    // Private profile: only its owner can read or write it.
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validScore()
        && request.resource.data.keys().hasOnly(
             ['name', 'ageRange', 'photoSource', 'stars', 'levels', 'updatedAt'])
        && request.resource.data.ageRange in
             ['teen', 'youngAdult', 'adult', 'midAdult', 'senior'];
    }

    // Public leaderboard row: nickname and score only.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validScore()
        && request.resource.data.keys().hasOnly(
             ['name', 'stars', 'levels', 'updatedAt']);
    }
  }
}
